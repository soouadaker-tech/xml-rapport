<?xml version="1.0" encoding="UTF-8"?>

<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    
    <xsd:element name="rapport">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="mandat"
                    type="T_MANDAT"
                    minOccurs="1"
                    maxOccurs="unbounded"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>
    
    <xsd:complexType name="T_MANDAT">
        <xsd:sequence>
            <xsd:element name="expediteur" type="T_EXP"/>
            <xsd:element name="destinataire" type="T_DEST"/>
        </xsd:sequence>
        
        <xsd:attribute name="num" type="xsd:int" use="required"/>
        <xsd:attribute name="date" type="xsd:date" use="required"/>
        <xsd:attribute name="montant" type="xsd:double" use="required"/>
        
        <xsd:attribute name="etat" use="required">
            <xsd:simpleType>
                <xsd:restriction base="xsd:string">
                    <xsd:enumeration value="reçu"/>
                    <xsd:enumeration value="non_reçu"/>
                </xsd:restriction>
            </xsd:simpleType>
        </xsd:attribute>
    </xsd:complexType>
    
    <xsd:complexType name="T_EXP">
        <xsd:attribute name="cin" type="xsd:string" use="required"/>
        <xsd:attribute name="nom" type="xsd:string" use="required"/>
        <xsd:attribute name="prenom" type="xsd:string" use="required"/>
        <xsd:attribute name="ville" type="xsd:string" use="required"/>
    </xsd:complexType>
    
    <xsd:complexType name="T_DEST">
        <xsd:attribute name="cin" type="xsd:string" use="required"/>
        <xsd:attribute name="nom" type="xsd:string" use="required"/>
        <xsd:attribute name="prenom" type="xsd:string" use="required"/>
        <xsd:attribute name="ville" type="xsd:string" use="required"/>
    </xsd:complexType>
    
</xsd:schema>